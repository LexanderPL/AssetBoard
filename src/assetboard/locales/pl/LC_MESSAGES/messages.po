msgid "The archive contains duplicate file names."
msgstr "Archiwum zawiera powtarzające się nazwy plików."

msgid "The archive is missing required files."
msgstr "W archiwum brakuje wymaganych plików."

msgid "The archive contains too many files."
msgstr "Archiwum zawiera zbyt wiele plików."

msgid "The archive contains an unsafe file."
msgstr "Archiwum zawiera niebezpieczny plik."

