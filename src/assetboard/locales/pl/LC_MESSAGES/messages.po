msgid "Unallocated"
msgstr "Bez przydziału"

msgid "Risk targets saved."
msgstr "Zapisano cele ryzyka."

msgid "Choose a target mode."
msgstr "Wybierz tryb celu."

msgid "Enter a percentage between 0 and 100 with at most two decimals."
msgstr "Wpisz procent od 0 do 100 z co najwyżej dwoma miejscami po przecinku."

msgid "The fixed targets must total exactly 100%."
msgstr "Stałe cele muszą sumować się dokładnie do 100%%."

msgid "Set your birth year in Profile before using age-based targets."
msgstr "Ustaw rok urodzenia w profilu, zanim użyjesz celów zależnych od wieku."

msgid "Asset classes"
msgstr "Klasy aktywów"

msgid "Nothing is valued in the portfolio yet."
msgstr "W portfelu nie ma jeszcze wycenionych pozycji."

msgid "Holdings by instrument"
msgstr "Pozycje według instrumentu"

#, python-format
msgid "Holdings by instrument in %(class)s"
msgstr "Pozycje według instrumentu w klasie %(class)s"

msgid "Nothing is held in this asset class."
msgstr "W tej klasie aktywów nie ma żadnych pozycji."

#, python-format
msgid "Rate limited; try again in %(minutes)s minutes."
msgstr "Ograniczenie tempa; spróbuj ponownie za %(minutes)s min."

#, python-format
msgid ""
"Refresh complete: %(prices)s prices and %(rates)s FX rates; %(skipped)s "
"skipped."
msgstr ""
"Odświeżanie zakończone: %(prices)s cen i %(rates)s kursów FX; pominięto "
"%(skipped)s."

#, python-format
msgid "Refresh complete: %(prices)s prices and %(rates)s FX rates."
msgstr "Odświeżanie zakończone: %(prices)s cen i %(rates)s kursów FX."

#, python-format
msgid "Refresh complete with %(errors)s errors."
msgstr "Odświeżanie zakończone z błędami: %(errors)s."

msgid "Enable the provider before refreshing."
msgstr "Włącz dostawcę przed odświeżeniem."

msgid "No held instruments need this provider."
msgstr "Żaden posiadany instrument nie potrzebuje tego dostawcy."

msgid "The provider could not be refreshed."
msgstr "Nie udało się odświeżyć dostawcy."

msgid "Provider settings saved."
msgstr "Zapisano ustawienia dostawcy."

msgid "Enter an API key and a daily call budget of at least 1."
msgstr "Podaj klucz API i dzienny limit wywołań co najmniej 1."

msgid "The provider settings could not be saved."
msgstr "Nie udało się zapisać ustawień dostawcy."

msgid ""
"Sign-in through your proxy is not available for this request. Try again; "
"if it keeps failing, contact your administrator."
msgstr ""
"Logowanie przez serwer proxy nie jest dostępne dla tego żądania. Spróbuj "
"ponownie, a jeśli problem się powtarza, skontaktuj się z administratorem."

msgid ""
"There is no account for your sign-in. Ask an administrator for an "
"invitation."
msgstr ""
"Z Twoim logowaniem nie jest powiązane żadne konto. Poproś administratora "
"o zaproszenie."

msgid ""
"Your proxy did not send a usable email address, so no account can be "
"created or linked. Contact your administrator."
msgstr ""
"Serwer proxy nie przekazał poprawnego adresu e-mail, więc nie można "
"utworzyć ani powiązać konta. Skontaktuj się z administratorem."

#, python-format
msgid ""
"Your browser did not keep the sign-in. Open this site at its configured "
"address (%(base_url)s), allow cookies for it, and try again."
msgstr ""
"Przeglądarka nie zachowała logowania. Otwórz tę stronę pod "
"skonfigurowanym adresem (%(base_url)s), zezwól na pliki cookie dla niej i"
" spróbuj ponownie."

msgid "on Monday"
msgstr "w poniedziałek"

msgid "on Tuesday"
msgstr "we wtorek"

msgid "on Wednesday"
msgstr "w środę"

msgid "on Thursday"
msgstr "w czwartek"

msgid "on Friday"
msgstr "w piątek"

msgid "on Saturday"
msgstr "w sobotę"

msgid "on Sunday"
msgstr "w niedzielę"

