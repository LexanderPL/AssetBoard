msgid "The last delivery was interrupted; the next daily run retries it."
msgstr ""
"Ostatnie doręczenie zostało przerwane; następne codzienne uruchomienie "
"ponowi próbę."

msgid "The channel could not be saved. Check the form and try again."
msgstr "Nie udało się zapisać kanału. Sprawdź formularz i spróbuj ponownie."

msgid "Channel saved. Send a test message to check it."
msgstr "Zapisano kanał. Wyślij wiadomość testową, aby go sprawdzić."

msgid "Channel saved."
msgstr "Zapisano kanał."

msgid "Channel deleted."
msgstr "Usunięto kanał."

msgid "Test message sent. Check your device."
msgstr "Wysłano wiadomość testową. Sprawdź swoje urządzenie."

msgid "Due soon"
msgstr "Wkrótce termin"

msgid "Overdue"
msgstr "Zaległe"

msgid "Work log"
msgstr "Dziennik pracy"

msgid "Sent"
msgstr "Wysłano"

msgid "Failed"
msgstr "Niepowodzenie"

msgid "Sending"
msgstr "Wysyłanie"

msgid ""
"This sign-in expired, or another sign-in was started in a different tab. "
"Start over."
msgstr ""
"To logowanie wygasło albo w innej karcie rozpoczęto kolejne logowanie. "
"Zacznij od nowa."

#, python-format
msgid "Sign-in with %(provider)s was cancelled."
msgstr "Logowanie przez %(provider)s zostało anulowane."

#, python-format
msgid ""
"Sign-in with %(provider)s did not work. Try again; if it keeps failing, "
"contact your administrator."
msgstr ""
"Logowanie przez %(provider)s nie powiodło się. Spróbuj ponownie, a jeśli "
"problem się powtarza, skontaktuj się z administratorem."

#, python-format
msgid "%(provider)s cannot be reached right now. Try again in a few minutes."
msgstr ""
"Nie można teraz połączyć się z dostawcą %(provider)s. Spróbuj ponownie za"
" kilka minut."

#, python-format
msgid ""
"There is no account for your %(provider)s sign-in. Ask an administrator "
"for an invitation."
msgstr ""
"Z Twoim logowaniem przez %(provider)s nie jest powiązane żadne konto. "
"Poproś administratora o zaproszenie."

msgid ""
"An account with this email address already exists. Sign in with your "
"password, then link it from your profile."
msgstr ""
"Konto z tym adresem e-mail już istnieje. Zaloguj się hasłem, a potem "
"powiąż je w swoim profilu."

#, python-format
msgid ""
"%(provider)s did not confirm that your email address is verified. Verify "
"it there, then try again."
msgstr ""
"Dostawca %(provider)s nie potwierdził, że Twój adres e-mail jest "
"zweryfikowany. Zweryfikuj go tam i spróbuj ponownie."

msgid "Accounts with your email domain cannot sign in here."
msgstr "Konta z Twojej domeny e-mail nie mogą się tutaj logować."

msgid "This account is deactivated. Contact your administrator."
msgstr "To konto jest dezaktywowane. Skontaktuj się z administratorem."

msgid "Too many accounts were created from your network. Try again later."
msgstr "Z Twojej sieci utworzono zbyt wiele kont. Spróbuj ponownie później."

msgid "The password is not correct. Try again, or start over."
msgstr "Hasło jest nieprawidłowe. Spróbuj ponownie lub zacznij od nowa."

msgid "This confirmation expired. Start over to sign in."
msgstr "To potwierdzenie wygasło. Zacznij od nowa, aby się zalogować."

msgid "Year to date"
msgstr "Od początku roku"

msgid "1 month"
msgstr "1 miesiąc"

msgid "3 months"
msgstr "3 miesiące"

msgid "Whole portfolio"
msgstr "Cały portfel"

msgid "Incomplete: an instrument has no price or FX rate."
msgstr "Niekompletne: instrument nie ma ceny lub kursu walutowego."

msgid "Value"
msgstr "Wartość"

msgid "Invested capital"
msgstr "Zainwestowany kapitał"

msgid "Gain"
msgstr "Zysk"

msgid "Annualised XIRR"
msgstr "Roczna stopa XIRR"

msgid "Period return"
msgstr "Stopa zwrotu za okres"

msgid "Saved / invested"
msgstr "Zaoszczędzone / zainwestowane"

msgid "Withdrawn from savings"
msgstr "Wypłacone z oszczędności"

msgid "Transfers (not counted)"
msgstr "Przelewy własne (nieliczone)"

msgid "A planned value cannot be negative."
msgstr "Wartość planowana nie może być ujemna."

