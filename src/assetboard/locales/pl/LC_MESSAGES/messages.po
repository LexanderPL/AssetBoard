msgid_plural "%(num)d days"
msgstr[0] "%(num)d dzień"
msgstr[1] "%(num)d dni"
msgstr[2] "%(num)d dni"

msgid "Only an account with this email address can accept the invitation."
msgstr "Zaproszenie może przyjąć tylko konto z tym adresem e-mail."

msgid ""
"The email is not verified, so share the link only with the person you "
"mean to invite."
msgstr ""
"Adres e-mail nie jest weryfikowany, więc udostępnij link tylko osobie, "
"którą chcesz zaprosić."

