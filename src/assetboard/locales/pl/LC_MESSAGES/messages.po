msgstr "Wybierz wydatki, przychody albo oba rodzaje."

msgid "The amount cannot be negative."
msgstr "Kwota nie może być ujemna."

msgid "The largest amount is below the smallest."
msgstr "Największa kwota jest mniejsza niż najmniejsza."

msgid "Choose one of the listed options."
msgstr "Wybierz jedną z opcji z listy."

msgid ""
"A decimal comma needs the semicolon delimiter, so that amounts stay one "
"column."
msgstr ""
"Przecinek dziesiętny wymaga średnika jako separatora pól, aby kwoty "
"pozostały w jednej kolumnie."

msgid "Select at least one entry."
msgstr "Zaznacz co najmniej jeden wpis."

#, python-format
msgid ""
"Too many entries for one change (at most %(max)d). Narrow the filters "
"first."
msgstr "Za dużo wpisów na jedną zmianę (najwyżej %(max)d). Najpierw zawęź filtry."

