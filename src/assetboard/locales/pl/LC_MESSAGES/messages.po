msgid_plural "%(first)d–%(last)d of %(num)d entries"
msgstr[0] "%(first)d–%(last)d z %(num)d wpisu"
msgstr[1] "%(first)d–%(last)d z %(num)d wpisów"
msgstr[2] "%(first)d–%(last)d z %(num)d wpisów"

