msgstr "Format archiwum nie jest obsługiwany."

msgid "The archive version is not supported."
msgstr "Wersja archiwum nie jest obsługiwana."

msgid "The archive contains invalid JSON."
msgstr "Archiwum zawiera nieprawidłowe dane JSON."

msgid "The archive contains invalid UTF-8 or CSV data."
msgstr "Archiwum zawiera nieprawidłowe dane UTF-8 lub CSV."

msgid "The file checksum does not match the manifest."
msgstr "Suma kontrolna pliku nie zgadza się z manifestem."

msgid "The file size does not match the manifest."
msgstr "Rozmiar pliku nie zgadza się z manifestem."

msgid "The file row count does not match the manifest."
msgstr "Liczba wierszy pliku nie zgadza się z manifestem."

msgid "The CSV delimiter option is invalid."
msgstr "Nieprawidłowy separator w opcjach pliku CSV."

msgid "The stored upload no longer matches its checksum."
msgstr "Zapisany plik nie zgadza się już z jego sumą kontrolną."

msgid "The stored upload is missing; upload the file again."
msgstr "Zapisanego pliku brakuje; prześlij plik ponownie."

msgid "The upload expired after 24 hours and was removed."
msgstr "Przesłany plik wygasł po 24 godzinach i został usunięty."

msgid "Import planning exceeded 60 seconds."
msgstr "Planowanie importu przekroczyło limit 60 sekund."

msgid "Other imports are being checked; try again in a minute."
msgstr "Trwa sprawdzanie innych importów; spróbuj ponownie za minutę."

msgid "Import planning failed."
msgstr "Planowanie importu nie powiodło się."

msgid "Already imported."
msgstr "Już zaimportowano."

msgid "Imported before and deleted; it is not brought back."
msgstr "Zaimportowano wcześniej i usunięto; nie zostanie przywrócony."

msgid "Changed since the export; the stored row is kept."
msgstr "Zmieniono od eksportu; zapisany wiersz zostaje."

msgid "The same row appears earlier in this file."
msgstr "Ten sam wiersz występuje wcześniej w tym pliku."

msgid "An earlier row of this file sets another value; it is kept."
msgstr ""
"Wcześniejszy wiersz tego pliku ustawia inną wartość; zostaje ona "
"zachowana."

msgid "The same planned value already exists."
msgstr "Taka sama wartość planowana już istnieje."

msgid "A different planned value exists; the stored value is kept."
msgstr "Istnieje inna wartość planowana; zapisana wartość zostaje."

msgid "The month is closed."
msgstr "Miesiąc jest zamknięty."

msgid "This file is only part of a full restore."
msgstr "Ten plik jest tylko częścią pełnego przywracania."

msgid "A required column is missing."
msgstr "Brakuje wymaganej kolumny."

msgid "The header contains a duplicate column."
msgstr "Nagłówek zawiera powtórzoną kolumnę."

msgid "Deleted in the source; it is not imported in merge mode."
msgstr "Usunięte w źródle; nie jest importowane w trybie scalania."

msgid "The date is in the future; it is not imported as an actual entry."
msgstr "Data jest w przyszłości; nie jest importowana jako rzeczywisty wpis."

msgid "The category is ignored for this import."
msgstr "Ta kategoria jest pomijana w tym imporcie."

msgid "The category is archived; no planned value can be added."
msgstr "Kategoria jest zarchiwizowana; nie można dodać wartości planowanej."

msgid "Transfer categories cannot have planned values."
msgstr "Kategorie transferów nie mogą mieć wartości planowanych."

msgid "The category already exists with different values; it is kept."
msgstr "Kategoria już istnieje z innymi wartościami; zostaje zachowana."

msgid "A category with this name already exists."
msgstr "Kategoria o tej nazwie już istnieje."

msgid ""
"The category kind is required: the name is unknown or exists as both an "
"expense and an income category."
msgstr ""
"Rodzaj kategorii jest wymagany: nazwa jest nieznana albo istnieje zarówno"
" jako kategoria wydatków, jak i przychodów."

msgid "The direction must be expense or income."
msgstr "Kierunek musi być wydatkiem lub przychodem."

msgid "The kind must be expense or income."
msgstr "Rodzaj musi być wydatkiem albo przychodem."

msgid "Enter a date as YYYY-MM-DD."
msgstr "Wpisz datę w formacie RRRR-MM-DD."

msgid "The date is outside 1900-01-01 to 2199-12-31."
msgstr "Data wykracza poza zakres od 1900-01-01 do 2199-12-31."

msgid "Enter a month as YYYY-MM."
msgstr "Wpisz miesiąc w formacie RRRR-MM."

msgid "Enter a plain positive amount."
msgstr "Wpisz dodatnią kwotę bez formatowania."

msgid "The amount must be greater than zero."
msgstr "Kwota musi być większa od zera."

msgid "The amount is too large."
msgstr "Kwota jest za duża."

msgid "The amount has too many decimal places."
msgstr "Kwota ma za dużo miejsc po przecinku."

msgid "The amount cannot be negative."
msgstr "Kwota nie może być ujemna."

msgid "The currency must be the workspace base currency."
msgstr "Waluta musi być walutą bazową obszaru roboczego."

msgid "The description contains characters that are not allowed."
msgstr "Opis zawiera niedozwolone znaki."

msgid "The description is too long."
msgstr "Opis jest za długi."

msgid "Enter a category name of 1 to 80 characters."
msgstr "Wpisz nazwę kategorii o długości od 1 do 80 znaków."

msgid "Choose a valid category treatment."
msgstr "Wybierz prawidłowe traktowanie kategorii."

msgid "Choose a valid colour."
msgstr "Wybierz prawidłowy kolor."

msgid "The sort order must be a whole number."
msgstr "Kolejność musi być liczbą całkowitą."

msgid "The id is not a valid UUID."
msgstr "Identyfikator nie jest prawidłowym UUID."

msgid "The timestamp is invalid."
msgstr "Znacznik czasu jest nieprawidłowy."

msgid "The row is invalid."
msgstr "Wiersz jest nieprawidłowy."

msgid "The mapped category does not exist."
msgstr "Docelowa kategoria nie istnieje."

msgid "The mapped category has the wrong kind."
msgstr "Docelowa kategoria ma niewłaściwy rodzaj."

msgid "Two new categories have the same kind and name."
msgstr "Dwie nowe kategorie mają ten sam rodzaj i nazwę."

msgid "No item with this name or id exists."
msgstr "Nie istnieje pozycja o tej nazwie lub identyfikatorze."

msgid "More than one item has this name; add the item_id column to choose one."
msgstr ""
"Więcej niż jedna pozycja ma tę nazwę; dodaj kolumnę item_id, aby wybrać "
"właściwą."

msgid "The item is archived; no valuation can be added."
msgstr "Pozycja jest zarchiwizowana; nie można dodać wyceny."

msgid "The item is linked; linked items cannot take manual values."
msgstr "Pozycja jest powiązana; powiązane pozycje nie przyjmują wartości ręcznych."

msgid "Enter an item name of 1 to 200 characters."
msgstr "Podaj nazwę pozycji o długości od 1 do 200 znaków."

msgid "The note is invalid or too long."
msgstr "Notatka jest nieprawidłowa lub zbyt długa."

msgid "The currency must match the item's currency."
msgstr "Waluta musi być zgodna z walutą pozycji."

msgid ""
"The linked item's target is not in this archive; it was restored as a "
"manual item without a value."
msgstr ""
"Cel powiązanej pozycji nie znajduje się w tym archiwum; przywrócono ją "
"jako pozycję ręczną bez wartości."

msgid "Net-worth files are restored only; they were ignored in this merge."
msgstr ""
"Pliki majątku netto służą tylko do przywracania; zostały pominięte w tym "
"scalaniu."

msgid "Investment files are restored only; they were ignored in this merge."
msgstr ""
"Pliki inwestycji służą tylko do przywracania; zostały pominięte w tym "
"scalaniu."

msgid "Loan files are restored only; they were ignored in this merge."
msgstr ""
"Pliki kredytów służą tylko do przywracania; zostały pominięte w tym "
"scalaniu."

msgid "A different value is already stored for this date; it is kept."
msgstr "Dla tej daty jest już zapisana inna wartość; pozostaje bez zmian."

msgid "Enter a whole rate in basis points between 0 and 10000."
msgstr "Podaj całą stawkę w punktach bazowych od 0 do 10000."

#, python-format
msgid "Re-enter the API key and enable %(provider)s."
msgstr "Wprowadź ponownie klucz API i włącz %(provider)s."

msgid "An asset class id appears more than once."
msgstr "Identyfikator klasy aktywów występuje więcej niż raz."

msgid "Two active asset classes have the same name."
msgstr "Dwie aktywne klasy aktywów mają tę samą nazwę."

msgid "An instrument id appears more than once."
msgstr "Identyfikator instrumentu występuje więcej niż raz."

msgid "Two active instruments have the same name."
msgstr "Dwa aktywne instrumenty mają tę samą nazwę."

msgid "A currency instrument's unit label must be its currency code."
msgstr "Etykieta jednostki instrumentu walutowego musi być kodem jego waluty."

msgid "An allocation id appears more than once."
msgstr "Identyfikator alokacji występuje więcej niż raz."

msgid "An allocation references an unknown or differently named row."
msgstr "Alokacja odwołuje się do nieznanego wiersza lub wiersza o innej nazwie."

msgid "The same instrument and asset class are allocated twice."
msgstr "Ten sam instrument i klasa aktywów są przypisane dwukrotnie."

msgid "An instrument's allocation weights must total exactly 100%."
msgstr "Wagi alokacji instrumentu muszą sumować się dokładnie do 100%."

msgid "An investment transaction id appears more than once."
msgstr "Identyfikator transakcji inwestycyjnej występuje więcej niż raz."

msgid ""
"An investment transaction references an unknown or differently named "
"instrument, or the wrong quote currency."
msgstr ""
"Transakcja inwestycyjna odwołuje się do nieznanego lub inaczej nazwanego "
"instrumentu albo do niewłaściwej waluty wyceny."

msgid "The settlement fields must be set together and only where allowed."
msgstr ""
"Pola rozliczenia muszą być ustawione razem i tylko tam, gdzie jest to "
"dozwolone."

msgid "A bond terms id appears more than once."
msgstr "Identyfikator warunków obligacji występuje więcej niż raz."

msgid "Bond terms reference an unknown instrument or the wrong type."
msgstr ""
"Warunki obligacji odwołują się do nieznanego instrumentu lub "
"niewłaściwego typu."

msgid "An instrument has more than one bond terms row."
msgstr "Instrument ma więcej niż jeden wiersz warunków obligacji."

msgid "The early-redemption fee is inconsistent."
msgstr "Opłata za wcześniejszy wykup jest niespójna."

msgid "The bond rate schedule is invalid."
msgstr "Harmonogram oprocentowania obligacji jest nieprawidłowy."

msgid "A price point id appears more than once."
msgstr "Identyfikator punktu cenowego występuje więcej niż raz."

msgid "A price point references an unknown or differently named instrument."
msgstr "Punkt cenowy odwołuje się do nieznanego lub inaczej nazwanego instrumentu."

msgid "The same instrument, date and source appear twice."
msgstr "Ten sam instrument, data i źródło występują dwukrotnie."

msgid "An FX rate id appears more than once."
msgstr "Identyfikator kursu walutowego występuje więcej niż raz."

msgid "An FX rate's base currency differs from the workspace."
msgstr ""
"Waluta bazowa kursu walutowego różni się od waluty bazowej obszaru "
"roboczego."

msgid "The same FX pair, date and source appear twice."
msgstr "Ta sama para walut, data i źródło występują dwukrotnie."

msgid "A provider config id or provider appears more than once."
msgstr ""
"Identyfikator konfiguracji dostawcy lub nazwa dostawcy występują więcej "
"niż raz."

msgid "A risk tier is not one of safe, growth or speculative."
msgstr "Poziom ryzyka nie jest jednym z: bezpieczny, wzrostowy lub spekulacyjny."

msgid "Choose a valid instrument type."
msgstr "Wybierz prawidłowy typ instrumentu."

msgid "An investment transaction type is not supported."
msgstr "Typ transakcji inwestycyjnej nie jest obsługiwany."

msgid "An instrument valuation source is not supported."
msgstr "Źródło wyceny instrumentu nie jest obsługiwane."

msgid "A bond interest mode is not supported."
msgstr "Tryb oprocentowania obligacji nie jest obsługiwany."

msgid "A whole-number field is invalid."
msgstr "Pole liczby całkowitej jest nieprawidłowe."

msgid "An allocation weight must be between 1 and 10 000 bp."
msgstr "Waga alokacji musi mieścić się między 1 a 10 000 bp."

msgid "A tax rate must be between 0 and 10 000 bp."
msgstr "Stawka podatku musi mieścić się między 0 a 10 000 bp."

msgid "A provider daily call budget must be between 1 and 100 000."
msgstr "Dzienny limit wywołań dostawcy musi mieścić się między 1 a 100 000."

msgid "A price source must be manual or provider."
msgstr "Źródło ceny musi być ręczne lub pochodzić od dostawcy."

msgid "An FX source is invalid."
msgstr "Źródło kursu walutowego jest nieprawidłowe."

msgid "A provider's FX backfill marker is invalid."
msgstr "Znacznik uzupełniania kursów walutowych dostawcy jest nieprawidłowy."

msgid "A decimal value is invalid or outside the supported range."
msgstr "Wartość dziesiętna jest nieprawidłowa lub poza obsługiwanym zakresem."

msgid "The amount has more decimals than its currency allows."
msgstr "Kwota ma więcej miejsc po przecinku, niż pozwala jej waluta."

msgid "Enter an instrument name of 1 to 200 characters."
msgstr "Podaj nazwę instrumentu o długości od 1 do 200 znaków."

msgid "No active instrument with this name or id exists."
msgstr "Nie istnieje aktywny instrument o tej nazwie lub identyfikatorze."

msgid "The file's quote currency differs from the instrument's."
msgstr "Waluta wyceny w pliku różni się od waluty instrumentu."

msgid "Create or activate an asset class before importing instruments."
msgstr "Utwórz lub aktywuj klasę aktywów przed importem instrumentów."

msgid "Enter a unit label of 1 to 32 characters."
msgstr "Wpisz nazwę jednostki o długości od 1 do 32 znaków."

#, python-format
msgid "The combined history would oversell %(instrument)s on %(date)s."
msgstr ""
"Połączona historia spowodowałaby sprzedaż większą niż posiadana dla "
"%(instrument)s w dniu %(date)s."

#, python-format
msgid "The combined history for %(instrument)s is invalid."
msgstr "Połączona historia dla %(instrument)s jest nieprawidłowa."

#, python-format
msgid ""
"No stored FX rate for %(currency)s on or before %(date)s; enter "
"fx_to_base."
msgstr ""
"Brak zapisanego kursu dla %(currency)s w dniu %(date)s lub wcześniej; "
"wpisz fx_to_base."

msgid "A settlement row must carry its own fx_to_base."
msgstr "Wiersz rozliczenia musi zawierać własny fx_to_base."

#, python-format
msgid "Undated lot: %(instrument)s will be imported without a date."
msgstr "Pozycja bez daty: %(instrument)s zostanie zaimportowany bez daty."

#, python-format
msgid "Rows for %(instrument)s are ignored for this import."
msgstr "Wiersze dla %(instrument)s są pomijane w tym imporcie."

msgid "The instrument mapping is incomplete or invalid."
msgstr "Mapowanie instrumentów jest niekompletne lub nieprawidłowe."

msgid ""
"The dividend's linked ledger income is not in this archive; it was "
"restored unlinked."
msgstr ""
"Powiązany przychód dywidendy nie znajduje się w tym archiwum; przywrócono"
" dywidendę bez powiązania."

msgid "The dividend's quantity, gross amount or withholding is invalid."
msgstr "Ilość, kwota brutto lub podatek potrącony dywidendy są nieprawidłowe."

msgid "Enter a valid quantity."
msgstr "Wpisz prawidłową ilość."

msgid "A split needs different positive new and old units, no fee and no FX."
msgstr ""
"Podział wymaga różnych dodatnich nowych i starych jednostek, bez opłaty i"
" bez kursu walutowego."

msgid "Enter a valid fee or withholding amount."
msgstr "Wpisz prawidłową opłatę lub kwotę podatku potrąconego."

msgid ""
"A dividend needs a positive FX rate, and 1 when quoted in the base "
"currency."
msgstr ""
"Dywidenda wymaga dodatniego kursu walutowego, a przy walucie bazowej "
"wartości 1."

msgid "A dividend cannot have settlement fields."
msgstr "Dywidenda nie może mieć pól rozliczenia."

msgid "A split needs different positive new and old units."
msgstr "Podział wymaga różnych dodatnich nowych i starych jednostek."

msgid "A split cannot have a fee."
msgstr "Podział nie może mieć opłaty."

msgid "A split cannot have an FX rate."
msgstr "Podział nie może mieć kursu walutowego."

msgid "A split cannot have settlement fields."
msgstr "Podział nie może mieć pól rozliczenia."

msgid "Splits are not available for currency or bond-model instruments."
msgstr "Podziały nie są dostępne dla instrumentów walutowych ani modeli obligacji."

msgid "Only a dividend can link to a ledger income row."
msgstr "Tylko dywidenda może być powiązana z pozycją przychodu w księdze."

msgid "Withholding cannot exceed the gross amount."
msgstr "Podatek potrącony nie może przekraczać kwoty brutto."

msgid "A net-worth category id appears more than once."
msgstr "Identyfikator kategorii majątku występuje więcej niż raz."

msgid "Two active net-worth categories have the same side and name."
msgstr "Dwie aktywne kategorie majątku mają tę samą stronę i nazwę."

msgid "A net-worth item id appears more than once."
msgstr "Identyfikator pozycji majątku występuje więcej niż raz."

msgid ""
"A net-worth item references a category of another side or with another "
"name."
msgstr "Pozycja majątku odwołuje się do kategorii innej strony lub o innej nazwie."

msgid "A linked net-worth item has an invalid link."
msgstr "Powiązana pozycja majątku ma nieprawidłowe powiązanie."

msgid "Two active net-worth items link to the same target."
msgstr "Dwie aktywne pozycje majątku netto prowadzą do tego samego celu."

msgid "An item valuation id appears more than once."
msgstr "Identyfikator wyceny pozycji występuje więcej niż raz."

msgid "An item valuation references an unknown item or a different name."
msgstr "Wycena pozycji odwołuje się do nieznanej pozycji lub innej nazwy."

msgid "A linked item cannot have a manual valuation."
msgstr "Powiązana pozycja nie może mieć ręcznej wyceny."

msgid "A net-worth snapshot id appears more than once."
msgstr "Identyfikator migawki majątku netto występuje więcej niż raz."

msgid "Two net-worth snapshots have the same date and source."
msgstr "Dwie migawki majątku netto mają tę samą datę i źródło."

msgid "The archive's base currency differs from this workspace's base currency."
msgstr "Waluta bazowa archiwum różni się od waluty bazowej tego obszaru roboczego."

msgid ""
"Restore is available only in an empty workspace (the untouched suggested "
"categories are fine)."
msgstr ""
"Przywracanie jest dostępne tylko w pustym obszarze roboczym (nietknięte "
"proponowane kategorie nie przeszkadzają)."

msgid "Two active categories in the archive have the same kind and name."
msgstr "Dwie aktywne kategorie w archiwum mają ten sam rodzaj i nazwę."

msgid "The archive's workspace settings are not supported."
msgstr "Ustawienia obszaru roboczego w archiwum nie są obsługiwane."

msgid "The archive was made by a newer version of the app."
msgstr "Archiwum zostało utworzone przez nowszą wersję aplikacji."

msgid "The archive was made by a newer minor version; unknown data was ignored."
msgstr ""
"Archiwum zostało utworzone przez nowszą wersję pomocniczą; nieznane dane "
"pominięto."

msgid "The workspace has rows that this restore did not write."
msgstr "Obszar roboczy zawiera wiersze, których to przywracanie nie zapisało."

msgid "Rows written by this restore were changed after it."
msgstr "Wiersze zapisane przez to przywracanie zostały później zmienione."

msgid "Month states written by this restore were changed after it."
msgstr "Stany miesięcy zapisane przez to przywracanie zostały później zmienione."

msgid "Workspace settings changed since the restore."
msgstr "Ustawienia obszaru roboczego zmieniły się po przywróceniu."

msgid ""
"Recurring items, income sources, work logs or tax rules were added after "
"the restore."
msgstr ""
"Po przywróceniu dodano pozycje cykliczne, źródła dochodu, ewidencję pracy"
" lub reguły podatkowe."

msgid ""
"Recurring items, income sources, work logs or tax rules reference rows "
"written by this restore."
msgstr ""
"Pozycje cykliczne, źródła dochodu, ewidencja pracy lub reguły podatkowe "
"odwołują się do wierszy zapisanych przez to przywracanie."

msgid "This restore did not record the workspace settings it replaced."
msgstr "To przywracanie nie zapisało ustawień obszaru roboczego, które zastąpiło."

#, python-format
