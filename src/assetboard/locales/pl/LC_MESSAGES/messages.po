msgid "%(num)d active scenario"
msgid_plural "%(num)d active scenarios"
msgstr[0] "%(num)d aktywny scenariusz"
msgstr[1] "%(num)d aktywne scenariusze"
msgstr[2] "%(num)d aktywnych scenariuszy"

